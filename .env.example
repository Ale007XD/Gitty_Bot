# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# CRITICAL: Gemini API region - MUST be set to avoid "User location not supported" errors
# This is passed as a GitHub secret and MUST be configured in your repository settings
# Recommended regions (test in order):
# europe-west1   - Europe West (RECOMMENDED - most stable for most regions)
# us-central1    - USA Central (may not work in some countries)
# asia-southeast1 - Asia Southeast (for Asian users)
GEMINI_REGION=europe-west1

# Logging Configuration
LOG_LEVEL=INFO
DEBUG=false

# Optional: Custom paths (default values shown)
# USER_DATA_PATH=/app/user_data
# LOGS_PATH=/app/logs
# MAX_MESSAGE_LENGTH=4000
# RATE_LIMIT_PER_MINUTE=30
